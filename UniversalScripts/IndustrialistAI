------------------------------------------------------------
TextChatService.MessageReceived:Connect(function(msg)
    if PauseListening or not CONFIG.ENABLE_AI or not msg.TextSource then return end
    
    local userId = msg.TextSource.UserId
    if userId == LocalPlayer.UserId and CONFIG.IGNORE_OWN_MESSAGES then return end
    
    local text = tostring(msg.Text or "")
    local prefix = CONFIG.PREFIX
    if CONFIG.ONLY_RESPOND_TO_PREFIX and string.lower(text):sub(1, #prefix) ~= string.lower(prefix) then
        return
    end

    local cleanQuestion = text:sub(#prefix + 1):match("^%s*(.-)%s*$") or ""
    if #cleanQuestion == 0 then return end

    ActiveStats.questionsDetected = ActiveStats.questionsDetected + 1
    UserInteractionStats[tostring(userId)] = (UserInteractionStats[tostring(userId)] or 0) + 1

    local p = Players:GetPlayerByUserId(userId)
    table.insert(RequestQueue, {
        userId = tostring(userId),
        playerName = p and p.DisplayName or "Unknown",
        question = cleanQuestion
    })

    task.spawn(ProcessRequestQueueLoop)
end)

