local function DisableNoclip()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end
end

local function EnableNoclip()
    DisableNoclip()
    NoclipConnection = RunService.Stepped:Connect(function()
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)
end

local function ExecuteMovementToPlayer(targetPlayer)
    if os.clock() - LastTeleportTime < CONFIG.TELEPORT_COOLDOWN then
        return false, "Movement on cooldown."
    end

    if not targetPlayer or not targetPlayer:IsA("Player") then
        return false, "Target player is invalid or not in server."
    end

    local targetChar = targetPlayer.Character
    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHRP then
        return false, targetPlayer.DisplayName .. "'s HumanoidRootPart not found."
    end

    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then
        return false, "Your character is not fully loaded."
    end

    local targetCFrame = targetHRP.CFrame * CFrame.new(0, 0, -3.5)

    if CONFIG.TRANSPORT_METHOD == "Instant" then
        localHRP.CFrame = targetCFrame
        LastTeleportTime = os.clock()
        ActiveStats.teleports = ActiveStats.teleports + 1
        return true, "Instantly teleported to " .. targetPlayer.DisplayName
    elseif CONFIG.TRANSPORT_METHOD == "Tween" then
        if ActiveTween then ActiveTween:Cancel() end
        
        local distance = (localHRP.Position - targetCFrame.Position).Magnitude
        local duration = math.max(0.1, distance / CONFIG.TWEEN_SPEED)

        EnableNoclip()
        
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        ActiveTween = TweenService:Create(localHRP, tweenInfo, { CFrame = targetCFrame })
        
        ActiveTween.Completed:Connect(function(playbackState)
            DisableNoclip()
            ActiveTween = nil
            if playbackState == Enum.PlaybackState.Completed then
                LastTeleportTime = os.clock()
                ActiveStats.teleports = ActiveStats.teleports + 1
                NotifyUI("Movement Complete", "Arrived at " .. targetPlayer.DisplayName, 3)
            end
        end)

        ActiveTween:Play()
        return true, string.format("Tweening to %s (ETA: %.1fs)", targetPlayer.DisplayName, duration)
    end

    return false, "Unknown transport method."
end

