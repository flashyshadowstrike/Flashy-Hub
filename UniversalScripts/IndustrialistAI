local function GetRBXGeneralChannel()
    local textChannels = TextChatService:FindFirstChild("TextChannels")
    if textChannels then
        return textChannels:FindFirstChild("RBXGeneral")
    end
    return nil
end

local function DirectSendAsyncChat(messageText)
    local general = GetRBXGeneralChannel()
    if not general then
        AddActivity("[CHAT] Failed: RBXGeneral channel not found.", "Errors")
        return false, "RBXGeneral missing"
    end

    local ok, err = pcall(function()
        general:SendAsync(messageText)
    end)

    if ok then
        ActiveStats.chatSent = ActiveStats.chatSent + 1
        AddActivity("[CHAT] Sent: " .. messageText, "Actions")
        return true
    else
        AddActivity("[CHAT] SendAsync failed: " .. tostring(err), "Errors")
        return false, err
    end
end

local function ProcessChatOutputQueue()
    if ProcessingChat then return end
    ProcessingChat = true

    while #ChatOutputQueue > 0 do
        local messageText = table.remove(ChatOutputQueue, 1)
        
        if not messageText:find("#####", 1, true) then
            DirectSendAsyncChat(messageText)
        else
            AddActivity("[CHAT] Skipped output message due to ##### filtering", "Errors")
        end

        task.wait(CONFIG.CHAT_COOLDOWN)
    end

    ProcessingChat = false
end

local function QueueResponseForChat(fullText)
    local maxLen = 160
    local text = fullText
    while #text > maxLen do
        local splitIdx = text:sub(1, maxLen):match(".*()%s") or maxLen
        table.insert(ChatOutputQueue, text:sub(1, splitIdx))
        text = text:sub(splitIdx + 1)
    end
    if #text > 0 then
        table.insert(ChatOutputQueue, text)
    end
    task.spawn(ProcessChatOutputQueue)
end

