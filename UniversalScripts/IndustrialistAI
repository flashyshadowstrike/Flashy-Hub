local function AddActivity(text, category)
    category = category or "All"
    local entry = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), category, tostring(text))
    table.insert(ActivityLogs, 1, { text = entry, cat = category })
    while #ActivityLogs > CONFIG.MAX_ACTIVITY_LOGS do table.remove(ActivityLogs) end
    
    pcall(function()
        if LiveActivityParagraph then
            local filtered = {}
            for _, item in ipairs(ActivityLogs) do
