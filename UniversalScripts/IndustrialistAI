-- QUEUE & CHAT EXECUTION
------------------------------------------------------------
local function ProcessSingleRequest(item)
    SetStatus("Processing")
    UpdateRequestDisplay(item.playerName, item.question, "Analyzing", "Thinking")
    AddActivity(item.playerName .. " asked: " .. item.question, "Questions")

    local history = PlayerHistories[item.userId] or {}
    local messages = {
        { role = "system", content = GetSystemPrompt(CONFIG.RESPONSE_STYLE, CONFIG.PERSONALITY) }
    }

    for _, h in ipairs(history) do
        table.insert(messages, { role = h.role, content = h.content })
    end

    table.insert(messages, {
        role = "user",
        content = string.format("[Player: %s | UserId: %s]\nQuestion: %s", item.playerName, tostring(item.userId), item.question)
    })

    local rawResponse, apiErr = nil, nil
    for attempt = 1, CONFIG.MAX_RETRIES do
        rawResponse, apiErr = DispatchGrokAPI(messages)
        if rawResponse and not rawResponse:find("#####", 1, true) then
            break
        end
        ActiveStats.retries = ActiveStats.retries + 1
        task.wait(CONFIG.RETRY_DELAY)
    end

    if not rawResponse then
        ActiveStats.failed = ActiveStats.failed + 1
        SetStatus("Error")
        AddActivity("API Call Failed: " .. tostring(apiErr), "Errors")
        UpdateRequestDisplay("None", "None", "Idle", "Failed")
        return
    end

    local chatText, actionObj = ParseAIOutput(rawResponse)
    
    -- Save History
    PlayerHistories[item.userId] = PlayerHistories[item.userId] or {}
    table.insert(PlayerHistories[item.userId], { role = "user", content = item.question })
    table.insert(PlayerHistories[item.userId], { role = "assistant", content = chatText })

    UpdateLastResponseDisplay(chatText)
    AddActivity("Generated response for " .. item.playerName, "AI Responses")

    -- Movement Action Trigger
    if actionObj.teleport_requested or actionObj.intent == "TELEPORT" then
        local targetPlayer = Players:GetPlayerByUserId(tonumber(item.userId))
        if targetPlayer then
            local ok, msg = ExecuteMovementToPlayer(targetPlayer)
            AddActivity("Action: " .. msg, "Actions")
        end
    end

    -- Queue Public Chat Output
    table.insert(ChatOutputQueue, chatText)
    ActiveStats.successful = ActiveStats.successful + 1
    UpdateRequestDisplay("None", "None", "Idle", "Complete")
    SetStatus("Ready")
end

local function ProcessRequestQueueLoop()
    if ProcessingQueue then return end
    ProcessingQueue = true

    while #RequestQueue > 0 do
        local item = table.remove(RequestQueue, 1)
        ProcessSingleRequest(item)
        task.wait(CONFIG.REQUEST_COOLDOWN)
    end

    ProcessingQueue = false
end

