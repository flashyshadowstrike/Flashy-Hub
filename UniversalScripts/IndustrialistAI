-- QUIZBOT MENTION & TAG DETECTION ENGINE
------------------------------------------------------------
local function InspectAndExtractQuestion(rawText)
    local localUserId = LocalPlayer.UserId
    local localName = LocalPlayer.Name
    local localDisplay = LocalPlayer.DisplayName
    local prefix = CONFIG.PREFIX

    local isAddressed = false
    local cleanText = rawText

    -- Pattern matches for Quizbot Tag system
    local tagPatterns = {
        "<@" .. tostring(localUserId) .. ">",
        "@" .. string.lower(localName),
        "@" .. string.lower(localDisplay)
    }

    local rawLower = string.lower(rawText)

    -- 1. Test for Tag/Mention
    for _, pattern in ipairs(tagPatterns) do
        local startIdx, endIdx = rawLower:find(pattern, 1, true)
        if startIdx then
            isAddressed = true
            -- Strip mention tag out of the text
            cleanText = cleanText:sub(1, startIdx - 1) .. cleanText:sub(endIdx + 1)
            break
        end
    end

    -- 2. Test for Prefix Trigger
    local prefixLower = string.lower(prefix)
    if not isAddressed and prefixLower ~= "" then
        if rawLower:sub(1, #prefixLower) == prefixLower then
            isAddressed = true
            cleanText = cleanText:sub(#prefix + 1)
        end
    end

    -- If message contained both tag & prefix, remove leftover prefix
    if isAddressed and prefixLower ~= "" then
        local trimmedLower = string.lower(cleanText:match("^%s*(.-)%s*$" ) or "")
        if trimmedLower:sub(1, #prefixLower) == prefixLower then
            cleanText = cleanText:match("^%s*(.-)%s*$"):sub(#prefix + 1)
        end
    end

    cleanText = cleanText:match("^%s*(.-)%s*$") or ""

    return isAddressed, cleanText
end

local function OnChatMessageReceived(message)
    if PauseListening or not CONFIG.ENABLE_AI or not CONFIG.ENABLE_COMMAND then return end
    if not message or not message.TextSource then return end

    local source = message.TextSource
    local userId = source.UserId
    if not userId or userId == 0 then return end

    local senderPlayer = Players:GetPlayerByUserId(userId)
    if not senderPlayer then return end

    -- Sender Filters
    if userId == LocalPlayer.UserId then
        if CONFIG.IGNORE_OWN_MESSAGES then return end
    else
        if not CONFIG.LISTEN_TO_OTHERS then return end
    end

    local rawText = tostring(message.Text or "")
    local isAddressed, cleanQuestion = InspectAndExtractQuestion(rawText)

    if not isAddressed then
        AddActivity(string.format("[CHAT] %s: %s [TAG] No AI mention detected", senderPlayer.DisplayName, rawText), "Questions")
        return
    end

    AddActivity(string.format("[CHAT] %s: %s", senderPlayer.DisplayName, rawText), "Questions")
    AddActivity("[TAG] AI mention/prefix detected!", "Questions")

    if #cleanQuestion == 0 then
        AddActivity("[TAG] Message ignored: empty prompt after tag removal", "Questions")
        return
    end

    -- Check Per-User Tag Cooldown
    local now = os.clock()
    local lastTag = LastUserTagTimestamp[userId] or 0
    local elapsed = now - lastTag

    if elapsed < CONFIG.TAG_COOLDOWN then
        local remaining = math.ceil(CONFIG.TAG_COOLDOWN - elapsed)
        AddActivity(string.format("[TAG COOLDOWN] Ignored tag from %s (%ds remaining)", senderPlayer.DisplayName, remaining), "Errors")
        
        -- Tag Cooldown Alert Sent to Public Chat
        DirectSendAsyncChat(string.format("[AI] @%s I received your tag! Please wait %ds before asking another question.", senderPlayer.DisplayName, remaining))
        return
    end

    -- Record Tag timestamp
    LastUserTagTimestamp[userId] = now

    AddActivity("[TAG] Clean Question: " .. cleanQuestion, "AI Responses")

    -- AUTO-TWEEN TRIGGER
    if CONFIG.AUTO_TWEEN_ON_HELP and userId ~= LocalPlayer.UserId then
        local ok, msg = ExecuteMovementToPlayer(senderPlayer)
        AddActivity("[AUTO-TWEEN] " .. msg, "Actions")
    end

    ActiveStats.questionsDetected = ActiveStats.questionsDetected + 1
    UserInteractionStats[tostring(userId)] = (UserInteractionStats[tostring(userId)] or 0) + 1

    table.insert(RequestQueue, {
        userId = tostring(userId),
        username = senderPlayer.Name,
        playerName = senderPlayer.DisplayName,
        question = cleanQuestion
    })

    task.spawn(ProcessRequestQueueLoop)
end

local function InitializeChatListener()
    if ChatMessageConnection then
        pcall(function() ChatMessageConnection:Disconnect() end)
        ChatMessageConnection = nil
    end

    local ok, err = pcall(function()
        ChatMessageConnection = TextChatService.MessageReceived:Connect(OnChatMessageReceived)
    end)

    if ok then
        AddActivity("[SYSTEM] Quizbot Chat & Tag Listener connected via TextChatService.MessageReceived", "System")
    else
        AddActivity("[SYSTEM] Chat Listener error: " .. tostring(err), "Errors")
    end
end

