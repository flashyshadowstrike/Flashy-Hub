-- GROK API DISPATCH & PARSING ENGINE
------------------------------------------------------------
local function GetRequestImpl()
    if syn and syn.request then return syn.request end
    if http and http.request then return http.request end
    if request then return request end
    if http_request then return http_request end
    return nil
end

local function DispatchGrokAPI(messages)
    if CONFIG.GROK_API_KEY == "" then return nil, "Missing Groq API Key." end

    local payload = HttpService:JSONEncode({ model = CONFIG.GROK_MODEL, messages = messages, temperature = 0.2 })
    local headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. CONFIG.GROK_API_KEY }

    local reqFn = GetRequestImpl()
    local ok, response = pcall(function()
        if reqFn then return reqFn({ Url = CONFIG.GROK_ENDPOINT, Method = "POST", Headers = headers, Body = payload })
        else return HttpService:RequestAsync({ Url = CONFIG.GROK_ENDPOINT, Method = "POST", Headers = headers, Body = payload }) end
    end)

    if not ok or not response then return nil, "HTTP Transport error." end
    local statusCode = tonumber(response.StatusCode or response.Status or 0)
    if statusCode < 200 or statusCode >= 300 then return nil, "HTTP Error " .. tostring(statusCode) end

    local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response.Body or response.body) end)
    if not decodeOk or type(decoded) ~= "table" or not decoded.choices or not decoded.choices[1] then
        return nil, "Malformed choices output."
    end

    return tostring(decoded.choices[1].message.content)
end

local function ParseAIOutput(rawContent)
    local chatText, actionJsonStr = rawContent:match("^(.-)%-%-%-ACTION_JSON%-%-%-(.*)$")
    if not chatText then chatText, actionJsonStr = rawContent, "{}" end
    chatText = chatText:match("^%s*(.-)%s*$") or rawContent
    local decodeOk, actionObj = pcall(function() return HttpService:JSONDecode(actionJsonStr) end)
    if not decodeOk or type(actionObj) ~= "table" then actionObj = { intent = "QUESTION", teleport_requested = false } end
    return chatText, actionObj
end

