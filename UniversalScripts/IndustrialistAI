local function NotifyUI(title, content, duration)
    pcall(function()
        WindUI:Notify({ Title = title, Content = tostring(content), Duration = duration or 4 })
    end)
end

local function SetStatus(newStatus)
    CurrentStatus = newStatus
    pcall(function()
        if StatusParagraph then
            StatusParagraph:Set({ 
                Title = "AI Status: " .. CurrentStatus, 
                Desc = string.format("API Status: %s | Chat: %s | Queue: %d", 
                    (CONFIG.GROK_API_KEY ~= "" and "Connected" or "Disconnected"),
                    (PauseListening and "Paused" or "Listening"),
                    #RequestQueue
                ) 
            })
        end
    end)
end

local ActivityLogs = {}
local CurrentFilter = "All"

local function AddActivity(text, category)
    category = category or "All"
    local entry = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), category, tostring(text))
    table.insert(ActivityLogs, 1, { text = entry, cat = category })
    while #ActivityLogs > CONFIG.MAX_ACTIVITY_LOGS do table.remove(ActivityLogs) end
    
    pcall(function()
        if LiveActivityParagraph then
            local filtered = {}
            for _, item in ipairs(ActivityLogs) do
                if CurrentFilter == "All" or item.cat == CurrentFilter then
                    table.insert(filtered, item.text)
                end
            end
            LiveActivityParagraph:Set({ Title = "REAL-TIME ACTIVITY MONITOR", Desc = table.concat(filtered, "\n\n") })
        end
    end)
end

