-- PERFORMANCE TRACKING ENGINE
------------------------------------------------------------
local PerfData = { fps = 0, ping = 0, memory = 0 }
local FrameCount = 0
local LastFpsUpdate = os.clock()

RunService.RenderStepped:Connect(function()
    FrameCount = FrameCount + 1
    local now = os.clock()
    if now - LastFpsUpdate >= 1.0 then
        PerfData.fps = math.floor(FrameCount / (now - LastFpsUpdate))
        FrameCount = 0
        LastFpsUpdate = now
    end
end)

task.spawn(function()
    while true do
        task.wait(CONFIG.UPDATE_INTERVAL)
        if CONFIG.PERF_MONITOR_ENABLED then
            -- Ping calculation
            pcall(function()
                PerfData.ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            -- Memory calculation
            pcall(function()
                PerfData.memory = math.floor(StatsService:GetTotalMemoryUsageMb())
            end)
        end
    end
end)

